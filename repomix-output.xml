    }));

    res.json({
      symbol,
      count: ticks.length,
      ticks,
    });
  } catch (err) {
    const message = err instanceof Error ? err.message : "Unknown error";
    console.error("[ticks]", message);
    res.status(502).json({ error: `Deriv API error: ${message}` });
  }
});

export default router;
